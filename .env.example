# Africa CDC DHIS Performance Monitor - production environment.
#
#   cp .env.example .env    then fill in every value marked CHANGE-ME
#
# .env holds live credentials. It is git-ignored and excluded from the image.

# --- public address ----------------------------------------------------------
# Scheme and host the app advertises. Use https in production: the app redirects
# http to https, and the session cookie is only marked Secure when this is https.
APP_URL=https://CHANGE-ME.africacdc.org
APP_NAME=Africa CDC DHIS Performance Monitor

# --- database ----------------------------------------------------------------
DB_NAME=afcdc_dhis
DB_USER=afcdc
DB_PASSWORD=CHANGE-ME-strong-password
DB_ROOT_PASSWORD=CHANGE-ME-different-strong-password

# --- runtime -----------------------------------------------------------------
# Port on the host that the reverse proxy forwards to (the web tier). Bound to 127.0.0.1 in
# docker-compose.yml so the container is never directly exposed.
HTTP_PORT=8081
# Interface the app listens on. 127.0.0.1 when the reverse proxy runs on this
# host; 0.0.0.0 when the proxy is on another machine (the production host).
HTTP_BIND=127.0.0.1

PHP_TIMEZONE=Africa/Addis_Ababa

# Which source addresses are trusted to set X-Forwarded-For, so access logs and
# REMOTE_ADDR show the real visitor rather than the proxy. 172.16.0.0/12 covers
# every Docker bridge network AND a reverse proxy anywhere on the private
# 172.16-31.x.x range. Narrow it to the proxy's own address if the proxy has a
# fixed IP; widen only if your proxy sits on 10.x or 192.168.x.
TRUSTED_PROXY_CIDR=172.16.0.0/12

# /requirements.php reports PHP, GD and server versions to whoever loads it.
# Keep this tight; widen it only while diagnosing an install.
REQUIREMENTS_ALLOW_FROM=127.0.0.1

# Leave false in production. True renders PHP errors to the browser.
APP_DEBUG=false

# On first start, load schema + content into an empty database. Never overwrites
# a database that already has tables or deliverables.
AUTO_MIGRATE=true

# InnoDB buffer pool. 4G is the 16 GB tier-M value and the default; lower it
# only on a smaller machine (e.g. 512M on a laptop).
#DB_BUFFER_POOL=4G

# --- Sign in with Microsoft (Entra ID) ----------------------------------------
# Optional. Leave the three ids empty and the sign-in page shows only the
# password form. Values come from an App registration in the africacdc.org
# tenant (Entra admin centre > App registrations > New registration):
#   Supported account types: this organisational directory only (single tenant)
#   Redirect URI (Web): https://mis.africacdc.org/users/sso_callback
#   Overview: copy "Directory (tenant) ID" and "Application (client) ID"
#   Certificates & secrets: New client secret -> copy the VALUE (shown once)
#   Token configuration (optional): optional claims email, given_name,
#     family_name on the ID token, so new accounts get proper names
#   Enterprise applications > this app > Properties > Assignment required: Yes,
#     if only people you assign in Entra may sign in (recommended)
SSO_TENANT_ID=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# Group for accounts created at first sign-in: 4 = Custom Users (dashboards
# only). Promote people in Manage users afterwards.
SSO_DEFAULT_GROUP=4
# Only these e-mail domains may sign in this way. Enforced by the app as well
# as by the tenant.
SSO_ALLOWED_DOMAINS=africacdc.org
# Advanced, normally empty: another OpenID authority (tests only), and the
# exact redirect URI when the app is not served at the root of APP_URL's host.
SSO_AUTHORITY=
SSO_REDIRECT_URI=
