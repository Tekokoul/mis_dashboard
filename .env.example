# Africa CDC DHIS Performance Monitor - production environment.
#
#   cp .env.example .env    then fill in every value marked CHANGE-ME
#
# .env holds live credentials. It is git-ignored and excluded from the image.

# --- public address ----------------------------------------------------------
# Scheme and host the app advertises. Use https in production: the app redirects
# http to https, and the session cookie is only marked Secure when this is https.
APP_URL=https://CHANGE-ME.africacdc.org
APP_NAME=Africa CDC DHIS Performance Monitor

# --- database ----------------------------------------------------------------
DB_NAME=afcdc_dhis
DB_USER=afcdc
DB_PASSWORD=CHANGE-ME-strong-password
DB_ROOT_PASSWORD=CHANGE-ME-different-strong-password

# --- runtime -----------------------------------------------------------------
# Port on the host that the reverse proxy forwards to (the web tier). Bound to 127.0.0.1 in
# docker-compose.yml so the container is never directly exposed.
HTTP_PORT=8081

PHP_TIMEZONE=Africa/Addis_Ababa

# CIDR of the reverse proxy, so access logs show the real client IP.
# Default covers the standard Docker bridge range.
TRUSTED_PROXY_CIDR=172.16.0.0/12

# /requirements.php reports PHP, GD and server versions to whoever loads it.
# Keep this tight; widen it only while diagnosing an install.
REQUIREMENTS_ALLOW_FROM=127.0.0.1

# Leave false in production. True renders PHP errors to the browser.
APP_DEBUG=false

# On first start, load schema + content into an empty database. Never overwrites
# a database that already has tables or deliverables.
AUTO_MIGRATE=true
