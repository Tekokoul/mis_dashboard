{
  "meta": {
    "name": "Division Users",
    "actions": [],
    "filters": [
      {
        "title": "Status",
        "key": "active",
        "type": "dropdown",
        "values_from": "values_list",
        "values_list": {
          "1": "Active",
          "0": "Inactive"
        },
        "add_zero_value": true
      }
    ]
  },
  "fields": {
    "id": {
      "hidden": true,
      "no_update": true
    },
    "name": {
      "type": "varchar",
      "appear_in_list": 0,
      "list_width": 35,
      "search_field": true,
      "order_field": "ASC"
    },
    "description": {
      "no_editor": true
    },
    "account": {
      "title": "Accounts allowed to record delivery",
      "type": "dropdown",
      "multiselect": true,
      "comma_separated": true,
      "_note": "Stored as a comma-separated list of core_users_tbl ids; projectsController resolves the signed-in user with FIND_IN_SET. It MUST stay a multiselect - as a single dropdown, saving this form silently reduced the list to one person and locked everyone else out of Progress.",
      "values_from": "db",
      "link_to_table": "core_users_tbl",
      "link_to_field": "givenname,sn,username",
      "order_by": "`username` asc",
      "where_clause": "and `active`=1",
      "appear_in_list": 1,
      "list_width": 40
    },
    "active": {
      "type": "dropdown",
      "appear_in_list": 2,
      "list_width": 10,
      "values_from": "values_list",
      "values_list": {
        "1": "Yes",
        "0": "No"
      }
    }
  }
}
