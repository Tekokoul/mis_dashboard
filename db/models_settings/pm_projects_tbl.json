      "link_to_table": "pm_objectives_tbl",
      "link_to_field": "abbr,name",
      "order_by": "CAST(SUBSTRING_INDEX(`abbr`,'.',1) AS UNSIGNED) asc, CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(CONCAT(`abbr`,'.0.0'),'.',2),'.',-1) AS UNSIGNED) asc, CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(CONCAT(`abbr`,'.0.0'),'.',3),'.',-1) AS UNSIGNED) asc, `abbr` asc",
      "where_clause": "",
      "required": true
    },
    "programme_id": {
      "title": "Programme",
