{
  "meta": {
    "name": "Progress Multiple KPIs",
    "actions": []
  },
  "fields": {
    "id": {
      "hidden": true,
      "no_update": true
    },
    "project_id": {
      "type": "int",
      "hidden": true
    },
    "task": {
      "type": "dropdown",
      "title": "Task",
      "values_from": "json",
      "option_field": "name",
      "no_update": true,
      "_note": "Virtual: options come from the activity's KPI JSON; there is no DB column named task (the column is task_id, written by task_progress_update). no_update keeps add_data()/update_data() from sending it."
    },
    "result": {
      "type": "dropdown",
      "values_from": "values_list",
      "values_list": {
        "0": "Not finished",
        "1": "Finished"
      }
    },
    "comment": {
      "type": "text",
      "no_editor": true
    },
    "progress_date": {
      "type": "datetime",
      "title": "Date"
    }
  }
}
