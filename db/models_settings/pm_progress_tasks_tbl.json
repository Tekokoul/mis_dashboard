{
  "meta": {
    "name": "Progress Multiple KPIs",
    "actions": [
    ]
  },
  "fields": {
    "id": {
      "hidden": true,
      "no_update": true
    },
    "project_id": {
      "type": "int",
      "hidden": true
    },
    "task": {
      "type": "dropdown",
      "title": "Task",
      "values_from": "json",
      "option_field": "name"
    },
    "result": {
      "type": "dropdown",
      "values_from": "values_list",
      "values_list": {
        "0": "Not finished",
        "1": "Finished"
      }
    },
    "comment": {
      "type": "text",
      "no_editor": true
    },
    "progress_date": {
      "type": "datetime",
      "title": "Date"
    }
  }
}